# ==============================================================================
# Production Voice Agent Environment Configuration
# ==============================================================================

# --- LiveKit Cloud / Server Configuration ---
# Get credentials from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Speech-to-Text (STT) ---
# Deepgram API key from https://console.deepgram.com ($200 free credit)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar

# --- Large Language Model (LLM) ---
# Primary: Groq Cloud API key from https://console.groq.com (Free tier: Llama 3.3 70B & 3.1 8B)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_STAGE_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# Fallback: Google Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Model Gateway & Circuit Breaker Limits
LLM_TTFT_TIMEOUT_S=3.5
LLM_REQUEST_TIMEOUT_S=10.0
VOICE_MAX_TOKENS=150
STAGE_MAX_TOKENS=256
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_S=60.0
CIRCUIT_BREAKER_COOLDOWN_S=60.0

# --- Text-to-Speech (TTS) ---
# ElevenLabs API key from https://elevenlabs.io (10k free credits/mo)
ELEVEN_API_KEY=your_elevenlabs_api_key
ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel or Arabic voice
ELEVEN_MODEL=eleven_turbo_v2_5

# --- Vector Database (RAG) ---
# Qdrant Cloud URL & Key from https://cloud.qdrant.io (Free 1GB cluster)
# Or leave empty for local in-memory/file storage during development
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=clinic_kb
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Egyptian Polyclinic Persona & Domain Settings ---
CLINIC_NAME="مجمع عيادات النور التخصصي"
CLINIC_TAGLINE="رعايتكم أولويتنا"
AGENT_NAME="نور"
CLINIC_PHONE="+20 2 3345 6789"
CLINIC_ADDRESS="شارع النصر، المعادي، القاهرة، مصر"
CLINIC_WORKING_HOURS="السبت - الخميس: 9:00 ص - 10:00 م | الجمعة: 2:00 م - 10:00 م"
EMERGENCY_PHONE="123"
RECEPTION_OPEN_TIME="09:00"
RECEPTION_CLOSE_TIME="22:00"
RECEPTION_FRIDAY_OPEN_TIME="14:00"

# --- Relational Database (Async) ---
DATABASE_URL=sqlite+aiosqlite:///./data/clinic.db

# --- Dashboard & App Config ---
DASHBOARD_PORT=8501
LOG_LEVEL=INFO
